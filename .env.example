# Copy to .env and adjust values (do not commit .env with real secrets).

DB_HOST=mariadb
# Host port published on your machine (MariaDB in container is always 3306)
DB_PUBLISH_PORT=3307
DB_NAME=chatplatform
DB_USER=chatuser
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_too

# Host port for the Vert.x API (container listens on 8080)
API_PORT=8080

# Host port for NGINX static frontend
FRONTEND_PORT=80

# phpMyAdmin (http://localhost:PHPMYADMIN_PORT)
PHPMYADMIN_PORT=8081
